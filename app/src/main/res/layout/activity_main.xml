<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F2"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="0dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:paddingBottom="8dp"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HOSCfg"
                android:textSize="22sp"
                android:textColor="#DE000000" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MIUI Home Customizer"
                android:textSize="13sp"
                android:textColor="#89000000"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Hide No SIM Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:layout_margin="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?android:attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hide No SIM Icon"
                        android:textSize="15sp"
                        android:textColor="#DE000000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Remove no SIM indicator from status bar"
                        android:textSize="12sp"
                        android:textColor="#89000000" />

                </LinearLayout>

                <Switch
                    android:id="@+id/toggle_hide_no_sim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Restart SystemUI -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_restart_systemui"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Restart SystemUI"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_margin="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp" />

        <!-- Drawer Background Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:layout_margin="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp">

            <!-- Section header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Drawer Background"
                android:textSize="14sp"
                android:textColor="#DE000000"
                android:textStyle="bold"
                android:paddingTop="16dp"
                android:paddingBottom="4dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Custom background color and transparency"
                android:textSize="12sp"
                android:textColor="#89000000"
                android:paddingBottom="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <!-- Color picker row -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="#1A000000"
                android:layout_marginStart="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:id="@+id/row_color_picker"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?android:attr/selectableItemBackground">

                <View
                    android:id="@+id/color_preview"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/circle_black"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Color"
                        android:textSize="15sp"
                        android:textColor="#DE000000" />

                    <TextView
                        android:id="@+id/text_color_hex"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#000000"
                        android:textSize="12sp"
                        android:textColor="#89000000" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="20sp"
                    android:textColor="#BDBDBD" />

            </LinearLayout>

            <!-- Alpha row -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="#1A000000"
                android:layout_marginStart="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Transparency"
                            android:textSize="15sp"
                            android:textColor="#DE000000" />

                        <TextView
                            android:id="@+id/text_alpha_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="Alpha: 255"
                            android:textSize="12sp"
                            android:textColor="#89000000" />

                </LinearLayout>

                <SeekBar
                    android:id="@+id/seek_alpha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="255"
                    android:progress="255"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Icon Label Color Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:layout_margin="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Icon Label Color"
                android:textSize="14sp"
                android:textColor="#DE000000"
                android:textStyle="bold"
                android:paddingTop="16dp"
                android:paddingBottom="4dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Color of app names in the drawer"
                android:textSize="12sp"
                android:textColor="#89000000"
                android:paddingBottom="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="#1A000000"
                android:layout_marginStart="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:id="@+id/row_label_color"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?android:attr/selectableItemBackground">

                <View
                    android:id="@+id/label_preview"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/circle_white"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Color"
                        android:textSize="15sp"
                        android:textColor="#DE000000" />

                    <TextView
                        android:id="@+id/text_label_hex"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Default"
                        android:textSize="12sp"
                        android:textColor="#89000000" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="20sp"
                    android:textColor="#BDBDBD" />

            </LinearLayout>

        </LinearLayout>

        <!-- Restart Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_restart"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Restart MIUI Home"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_margin="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Root required"
            android:textSize="11sp"
            android:textColor="#89000000"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
